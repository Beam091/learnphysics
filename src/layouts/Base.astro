---
// โครงหน้าเว็บที่ใช้ร่วมกันทุกหน้า: ส่วนหัว ส่วนท้าย และการโหลดฟอนต์/สไตล์
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "LearnPhysics เรียนฟิสิกส์ออนไลน์",
  description = "เว็บเรียนฟิสิกส์ภาษาไทย ม.ต้นถึง ม.ปลาย รวมคลิปสอน แอนิเมชั่นจำลอง เกม และแบบทดสอบ",
} = Astro.props;
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="th_TH" />
    <meta name="theme-color" content="#14213d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Prompt:wght@500;600&family=Sarabun:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("learnphysics.theme");
          if (t === "dark" || t === "light") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
            <path d="M3 27 Q16 -6 29 27" fill="none" stroke="currentColor" stroke-width="2.5" />
            <circle cx="16" cy="10.5" r="3" fill="var(--ball)" />
          </svg>
          <span>LearnPhysics</span>
        </a>
        <nav aria-label="เมนูหลัก">
          <a href="/courses">หลักสูตร</a>
          <span id="authSlot" class="auth-slot"></span>
          <button id="themeToggle" type="button" class="theme-toggle" aria-label="สลับโหมดมืดและสว่าง"><span class="theme-icon" aria-hidden="true">🌙</span><span class="theme-text">โหมดมืด</span></button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p><strong>พัฒนาโดย Bunlai IT Group</strong></p>
        <p>
          คลิปสอนทั้งหมดเป็นของเจ้าของช่องบน YouTube เว็บนี้รวบรวมเฉพาะลิงก์พร้อมเครดิตช่อง
          เพื่อการศึกษา ไม่แสวงหากำไร หากเจ้าของช่องต้องการให้ถอดลิงก์ เราจะดำเนินการทันที
        </p>
        <p class="site-version">เวอร์ชัน v3.3.0 · <a href="/privacy">ความเป็นส่วนตัว</a></p>
      </div>
    </footer>

    <script is:inline src="/auth.js"></script>
    <script is:inline>
      (function () {
        var btn = document.getElementById("themeToggle");
        if (!btn) return;
        function updateBtn(theme) {
          var isDark = theme === "dark";
          var icon = isDark ? "☀️" : "🌙";
          var text = isDark ? "โหมดสว่าง" : "โหมดมืด";
          btn.innerHTML = '<span class="theme-icon" aria-hidden="true">' + icon + '</span><span class="theme-text">' + text + '</span>';
          btn.setAttribute("aria-label", "สลับโหมดมืดและสว่าง (ปัจจุบัน: " + text + ")");
        }
        var cur = document.documentElement.getAttribute("data-theme");
        if (!cur) {
          cur = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        updateBtn(cur);

        btn.addEventListener("click", function () {
          var now = document.documentElement.getAttribute("data-theme");
          if (!now) {
            now = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          var next = now === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("learnphysics.theme", next);
          } catch (e) {}
          updateBtn(next);
        });
      })();
    </script>
  </body>
</html>
