---
import Base from "../layouts/Base.astro";

const categories = [
  {
    slug: "junior",
    level: "ม.ต้น",
    title: "ฟิสิกส์ ม.ต้น",
    count: "8 บท • 33 บทเรียน",
    desc: "แรง การเคลื่อนที่ งาน พลังงาน ของไหล ความร้อน เสียง แสง ไฟฟ้า แม่เหล็ก",
  },
  {
    slug: "mechanics",
    level: "ม.ปลาย",
    title: "กลศาสตร์ ม.ปลาย",
    count: "11 บท • 50 บทเรียน",
    desc: "การวัด เวกเตอร์ การเคลื่อนที่แนวตรง โพรเจกไทล์ นิวตัน งาน โมเมนตัม การหมุน การสั่น",
  },
  {
    slug: "waves-sound",
    level: "ม.ปลาย",
    title: "คลื่นและเสียง",
    count: "3 บท • 14 บทเรียน",
    desc: "คลื่นกล สมบัติของคลื่น เสียงและการได้ยิน",
  },
  {
    slug: "light-optics",
    level: "ม.ปลาย",
    title: "แสงและทัศนูปกรณ์",
    count: "2 บท • 10 บทเรียน",
    desc: "การสะท้อน การหักเห กฎของสเนลล์ เลนส์และกระจก",
  },
  {
    slug: "heat-gas",
    level: "ม.ปลาย",
    title: "ความร้อนและแก๊ส",
    count: "3 บท • 14 บทเรียน",
    desc: "ความร้อน การเปลี่ยนสถานะ ทฤษฎีจลน์ของแก๊ส เทอร์โมไดนามิกส์",
  },
  {
    slug: "electromagnetism",
    level: "ม.ปลาย",
    title: "ไฟฟ้าและแม่เหล็ก",
    count: "4 บท • 22 บทเรียน",
    desc: "ไฟฟ้าสถิต วงจรไฟฟ้ากระแสตรง สนามแม่เหล็ก การเหนี่ยวนำและไฟฟ้ากระแสสลับ",
  },
  {
    slug: "modern-physics",
    level: "ม.ปลาย",
    title: "ฟิสิกส์ยุคใหม่",
    count: "3 บท • 12 บทเรียน",
    desc: "ทฤษฎีสัมพัทธภาพพิเศษ ฟิสิกส์ควอนตัมและอะตอม ฟิสิกส์นิวเคลียร์",
  },
];
---
<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <h1>ฟิสิกส์ที่เห็นภาพ ลองปรับค่าแล้วดูผลได้ทันที</h1>
      <p class="lead">
        เว็บเรียนฟิสิกส์ภาษาไทยตั้งแต่ ม.ต้นถึง ม.ปลาย รวมคลิปสอน แอนิเมชั่นจำลอง เกม
        และแบบทดสอบไว้ในที่เดียว
      </p>
      <p class="status">เปิดเรียนฟรีครบ 100% — 155 บทเรียน ม.ต้น และ ม.ปลาย</p>
      <div class="hero-actions">
        <a class="button cta-main" href="/courses">เริ่มเรียนทันที 155 บทเรียน →</a>
        <a class="button secondary" href="/lesson?s=projectile-intro">ทดลองเรียนบทตัวอย่าง</a>
      </div>
    </div>

    <div class="sim">
      <h2>ลองยิงวัตถุเฉียงขึ้น</h2>
      <svg
        id="plot"
        viewBox="0 0 680 360"
        role="img"
        aria-label="กราฟแสดงเส้นทางของวัตถุที่ถูกยิงเฉียงขึ้น แกนนอนคือระยะทาง แกนตั้งคือความสูง หน่วยเมตร"
      ></svg>

      <div class="controls">
        <div class="field">
          <label for="angle">มุมยิง <output id="angleOut">45</output> องศา</label>
          <input id="angle" type="range" min="10" max="80" step="1" value="45" />
        </div>
        <div class="field">
          <label for="speed">ความเร็วต้น <output id="speedOut">25</output> เมตร/วินาที</label>
          <input id="speed" type="range" min="10" max="40" step="1" value="25" />
        </div>
        <button id="shoot" type="button">ยิง</button>
      </div>

      <dl class="results" aria-live="polite">
        <div><dt>ระยะไกลสุด</dt><dd id="rangeOut">-</dd></div>
        <div><dt>สูงสุด</dt><dd id="heightOut">-</dd></div>
        <div><dt>เวลาที่ลอย</dt><dd id="timeOut">-</dd></div>
      </dl>
      <p class="note">ไม่คิดแรงต้านอากาศ ใช้ g = 9.8 เมตร/วินาที²</p>
    </div>
  </section>

  <!-- แผงสถิติภาพรวม (Stats Dashboard) -->
  <section class="stats-section">
    <div class="wrap">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">155</div>
          <div class="stat-label">บทเรียนออนไลน์</div>
          <div class="stat-sub">ครบ 100% ตามหลักสูตร</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">7</div>
          <div class="stat-label">หมวดวิชาหลัก</div>
          <div class="stat-sub">ม.ต้น และ ม.ปลาย</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">260</div>
          <div class="stat-label">คลิปสอนคัดสรร</div>
          <div class="stat-sub">พร้อมเครดิตช่องครูไทย</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">15</div>
          <div class="stat-label">ตัวจำลองฟิสิกส์</div>
          <div class="stat-sub">ปรับค่าดูผลได้ทันที</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">7</div>
          <div class="stat-label">เกมฝึกทักษะ</div>
          <div class="stat-sub">เรียนรู้ผ่านการเล่น</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">775</div>
          <div class="stat-label">ข้อสอบพร้อมเฉลย</div>
          <div class="stat-sub">ตรวจคำตอบทันที</div>
        </div>
      </div>
    </div>
  </section>

  <!-- หมวดวิชาทั้งหมด (Featured Categories Grid) -->
  <section class="featured-categories wrap">
    <div class="section-head">
      <h2>หมวดวิชาทั้งหมด</h2>
      <p class="section-lead">ครอบคลุมฟิสิกส์ระดับมัธยมศึกษาทั้งสาย ม.ต้น และ ม.ปลาย เข้าศึกษาได้ทันทีทุกหมวด</p>
    </div>
    <div class="cat-grid">
      {categories.map((cat) => (
        <a class="cat-card" href={`/courses#cat-${cat.slug}`}>
          <div class="cat-card-header">
            <span class="cat-badge">{cat.level}</span>
            <span class="cat-card-count">{cat.count}</span>
          </div>
          <h3>{cat.title}</h3>
          <p>{cat.desc}</p>
          <span class="cat-card-link">เข้าสู่หลักสูตรหมวดนี้ →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ขั้นตอนการเรียนรู้ -->
  <section class="steps">
    <div class="wrap">
      <h2>ทุกบทเรียนมี 4 ขั้น</h2>
      <ol>
        <li>
          <strong>ดูคลิปสอน</strong>
          <span>ลิงก์ไปดูบน YouTube จากช่องครูไทยหลายช่อง</span>
        </li>
        <li>
          <strong>ลองจำลอง</strong>
          <span>ปรับค่าเองแล้วดูผลทันที เหมือนตัวอย่างด้านบน</span>
        </li>
        <li>
          <strong>เล่นเกม</strong>
          <span>ฝึกใช้ความรู้ผ่านเกมสั้นๆ</span>
        </li>
        <li>
          <strong>ทำแบบทดสอบ</strong>
          <span>ตรวจคำตอบพร้อมเฉลยอธิบาย</span>
        </li>
      </ol>
      <p class="soon">เข้าสู่ระบบด้วยบัญชี Google ฟรี เพื่อเข้าเรียนครบทั้ง 155 บทเรียน พร้อมบันทึกความคืบหน้า บุ๊กมาร์ก และโน้ตย่ออัตโนมัติ</p>
    </div>
  </section>

  <script is:inline defer src="/app.js"></script>
</Base>
