---
import Base from "../layouts/Base.astro";

const categories = [
  {
    slug: "junior",
    level: "ม.ต้น",
    title: "ฟิสิกส์ ม.ต้น",
    count: "8 บท • 33 บทเรียน",
    desc: "แรง การเคลื่อนที่ งาน พลังงาน ของไหล ความร้อน เสียง แสง ไฟฟ้า แม่เหล็ก",
  },
  {
    slug: "mechanics",
    level: "ม.ปลาย",
    title: "กลศาสตร์ ม.ปลาย",
    count: "11 บท • 50 บทเรียน",
    desc: "การวัด เวกเตอร์ การเคลื่อนที่แนวตรง โพรเจกไทล์ นิวตัน งาน โมเมนตัม การหมุน การสั่น",
  },
  {
    slug: "waves-sound",
    level: "ม.ปลาย",
    title: "คลื่นและเสียง",
    count: "3 บท • 14 บทเรียน",
    desc: "คลื่นกล สมบัติของคลื่น เสียงและการได้ยิน",
  },
  {
    slug: "light-optics",
    level: "ม.ปลาย",
    title: "แสงและทัศนูปกรณ์",
    count: "2 บท • 10 บทเรียน",
    desc: "การสะท้อน การหักเห กฎของสเนลล์ เลนส์และกระจก",
  },
  {
    slug: "heat-gas",
    level: "ม.ปลาย",
    title: "ความร้อนและแก๊ส",
    count: "3 บท • 14 บทเรียน",
    desc: "ความร้อน การเปลี่ยนสถานะ ทฤษฎีจลน์ของแก๊ส เทอร์โมไดนามิกส์",
  },
  {
    slug: "electromagnetism",
    level: "ม.ปลาย",
    title: "ไฟฟ้าและแม่เหล็ก",
    count: "4 บท • 22 บทเรียน",
    desc: "ไฟฟ้าสถิต วงจรไฟฟ้ากระแสตรง สนามแม่เหล็ก การเหนี่ยวนำและไฟฟ้ากระแสสลับ",
  },
  {
    slug: "modern-physics",
    level: "ม.ปลาย",
    title: "ฟิสิกส์ยุคใหม่",
    count: "3 บท • 12 บทเรียน",
    desc: "ทฤษฎีสัมพัทธภาพพิเศษ ฟิสิกส์ควอนตัมและอะตอม ฟิสิกส์นิวเคลียร์",
  },
];
---
<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <h1>แพลตฟอร์มการเรียนรู้ฟิสิกส์เชิงโต้ตอบ เห็นภาพและทดลองปรับค่าได้ทันที</h1>
      <p class="lead">
        ยกระดับความเข้าใจวิชาฟิสิกส์ระดับมัธยมศึกษาตอนต้นและตอนปลาย ด้วยสื่อการสอน ห้องปฏิบัติการจำลองเสมือนจริง กิจกรรมฝึกทักษะ และระบบประเมินผลพร้อมคำอธิบายเชิงลึก
      </p>
      <p class="status">รุ่นทดสอบระบบ (Public Beta) — เปิดให้ใช้งานครบทั้ง 155 บทเรียน ม.ต้น และ ม.ปลาย</p>
      <div class="hero-actions">
        <a class="button cta-main" href="/courses">เข้าสู่รายวิชาทั้งหมด →</a>
        <a class="button secondary" href="/lesson?s=projectile-intro">ดูตัวอย่างบทเรียน</a>
      </div>
    </div>

    <div class="sim">
      <h2>ห้องปฏิบัติการจำลอง: การเคลื่อนที่แบบโพรเจกไทล์</h2>
      <svg
        id="plot"
        viewBox="0 0 680 360"
        role="img"
        aria-label="กราฟแสดงเส้นทางของวัตถุที่ถูกยิงเฉียงขึ้น แกนนอนคือระยะทาง แกนตั้งคือความสูง หน่วยเมตร"
      ></svg>

      <div class="controls">
        <div class="field">
          <label for="angle">มุมยิง <output id="angleOut">45</output> องศา</label>
          <input id="angle" type="range" min="10" max="80" step="1" value="45" />
        </div>
        <div class="field">
          <label for="speed">ความเร็วต้น <output id="speedOut">25</output> เมตร/วินาที</label>
          <input id="speed" type="range" min="10" max="40" step="1" value="25" />
        </div>
        <button id="shoot" type="button">เริ่มจำลองการยิง</button>
      </div>

      <dl class="results" aria-live="polite">
        <div><dt>ระยะไกลสุด</dt><dd id="rangeOut">-</dd></div>
        <div><dt>สูงสุด</dt><dd id="heightOut">-</dd></div>
        <div><dt>เวลาที่ลอย</dt><dd id="timeOut">-</dd></div>
      </dl>
      <p class="note">จำลองสภาวะไร้แรงต้านอากาศ โดยใช้ค่าความเร่งโน้มถ่วงมาตรฐาน g = 9.8 m/s²</p>
    </div>
  </section>

  <!-- แผงสถิติภาพรวม (Stats Dashboard) -->
  <section class="stats-section">
    <div class="wrap">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">155</div>
          <div class="stat-label">บทเรียนมาตรฐาน</div>
          <div class="stat-sub">ครอบคลุมเนื้อหา ม.ต้น – ม.ปลาย</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">7</div>
          <div class="stat-label">หมวดวิชาหลัก</div>
          <div class="stat-sub">จัดโครงสร้างตามหลักสูตรแกนกลาง</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">260</div>
          <div class="stat-label">สื่อวิดีโอประกอบ</div>
          <div class="stat-sub">อธิบายแนวคิดและทฤษฎีครบทุกบท</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">15</div>
          <div class="stat-label">ห้องปฏิบัติการจำลอง</div>
          <div class="stat-sub">ปรับตัวแปรและดูผลลัพธ์แบบเรียลไทม์</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">7</div>
          <div class="stat-label">ชุดกิจกรรมฝึกทักษะ</div>
          <div class="stat-sub">ประยุกต์ใช้สมการผ่านโจทย์โต้ตอบ</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">775</div>
          <div class="stat-label">ข้อสอบวัดผลพร้อมเฉลย</div>
          <div class="stat-sub">ประเมินผลและอธิบายวิธีคิดทันที</div>
        </div>
      </div>
    </div>
  </section>

  <!-- หมวดวิชาทั้งหมด (Featured Categories Grid) -->
  <section class="featured-categories wrap">
    <div class="section-head">
      <h2>โครงสร้างหมวดวิชาในหลักสูตร</h2>
      <p class="section-lead">จัดแบ่งเนื้อหาอย่างเป็นระบบตั้งแต่ระดับมัธยมศึกษาตอนต้นถึงมัธยมศึกษาตอนปลาย เลือกหมวดวิชาเพื่อดูรายละเอียดบทเรียน</p>
    </div>
    <div class="cat-grid">
      {categories.map((cat) => (
        <a class="cat-card" href={`/courses#cat-${cat.slug}`}>
          <div class="cat-card-header">
            <span class="cat-badge">{cat.level}</span>
            <span class="cat-card-count">{cat.count}</span>
          </div>
          <h3>{cat.title}</h3>
          <p>{cat.desc}</p>
          <span class="cat-card-link">ดูรายละเอียดหมวดวิชานี้ →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ขั้นตอนการเรียนรู้ -->
  <section class="steps">
    <div class="wrap">
      <h2>กระบวนการเรียนรู้มาตรฐาน 4 ขั้นตอน</h2>
      <ol>
        <li>
          <strong>ศึกษาแนวคิดหลัก</strong>
          <span>เรียนรู้ทฤษฎีและที่มาของสมการผ่านสื่อวิดีโอประกอบการสอนในแต่ละหัวข้อ</span>
        </li>
        <li>
          <strong>ทดลองผ่านระบบจำลอง</strong>
          <span>ปรับเปลี่ยนตัวแปรทางฟิสิกส์ด้วยตนเองเพื่อสังเกตความสัมพันธ์และผลลัพธ์แบบเรียลไทม์</span>
        </li>
        <li>
          <strong>ฝึกทักษะการประยุกต์</strong>
          <span>แก้โจทย์สถานการณ์จำลองเชิงโต้ตอบเพื่อทบทวนความเข้าใจและทักษะการคำนวณ</span>
        </li>
        <li>
          <strong>ประเมินผลการเรียนรู้</strong>
          <span>ทำแบบทดสอบท้ายบทเรียนพร้อมรับผลการตรวจและคำอธิบายเฉลยอย่างละเอียดทันที</span>
        </li>
      </ol>
      <p class="soon">ระบบเปิดให้ใช้งานในช่วงทดสอบ (Public Beta) — เข้าสู่ระบบด้วยบัญชี Google เพื่อเริ่มต้นใช้งานและซิงค์ข้อมูลการเรียนของคุณอัตโนมัติ</p>
    </div>
  </section>

  <script is:inline defer src="/app.js"></script>
</Base>
