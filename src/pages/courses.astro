---
import Base from "../layouts/Base.astro";
---
<Base title="หลักสูตร | LearnPhysics">
  <div class="solid">
    <section class="wrap courses">
      <h1>หลักสูตรฟิสิกส์</h1>
      <p class="lead">
        หลักสูตรฟิสิกส์ครบวงจร 155 บทเรียน ครอบคลุมตั้งแต่ ม.ต้น ถึง ม.ปลาย ทุกบทมีครบทั้งคลิปสอน ตัวจำลองโต้ตอบ เกมฝึกทักษะ และแบบทดสอบพร้อมเฉลย
      </p>
      <div id="catalog" aria-live="polite">กำลังโหลดหลักสูตร...</div>
      <noscript><p>ต้องเปิด JavaScript เพื่อดูหลักสูตร</p></noscript>
    </section>
  </div>
  <script is:inline defer src="/courses.js"></script>
</Base>
