---
import Base from "../layouts/Base.astro";
---
<Base title="โครงสร้างหลักสูตรฟิสิกส์ | LearnPhysics">
  <div class="solid">
    <section class="wrap courses">
      <h1>โครงสร้างหลักสูตรฟิสิกส์</h1>
      <p class="lead">
        รวบรวมเนื้อหาฟิสิกส์ระดับมัธยมศึกษาตอนต้นและตอนปลายครบทั้ง 155 บทเรียน พร้อมสื่อการสอน ห้องปฏิบัติการจำลอง กิจกรรมฝึกทักษะ และแบบทดสอบวัดผลในทุกบทเรียน (รุ่นทดสอบระบบ Public Beta)
      </p>
      <div id="catalog" aria-live="polite">กำลังโหลดหลักสูตร...</div>
      <noscript><p>ต้องเปิด JavaScript เพื่อดูหลักสูตร</p></noscript>
    </section>
  </div>
  <script is:inline defer src="/courses.js"></script>
</Base>
